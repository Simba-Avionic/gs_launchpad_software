[Unit]
Description=Ground Segment Launchpad Software - tanking node
Requires=dev-ttyAMA1.device
After=dev-ttyAMA1.device

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=dialout
WorkingDirectory=/home/ubuntu/gs_launchpad_software
ExecStart=/home/ubuntu/gs_launchpad_software/run_tanking_node.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target


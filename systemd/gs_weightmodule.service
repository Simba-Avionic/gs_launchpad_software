[Unit]
Description=Ground Segment Launchpad Software - weight module node
Requires=dev-ttyAMA0.device
After=dev-ttyAMA0.device

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=dialout
WorkingDirectory=/home/ubuntu/gs_launchpad_software
ExecStart=/home/ubuntu/gs_launchpad_software/run_weight_module.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

